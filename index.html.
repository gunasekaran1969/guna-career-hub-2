<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Guna Career Hub</title>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,sans-serif;background:#f5f7fb;color:#172033}
header{background:linear-gradient(135deg,#1565c0,#4527a0);color:white;position:sticky;top:0;z-index:10}
.nav{max-width:1100px;margin:auto;padding:14px 18px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:22px;font-weight:bold}.menu{display:flex;gap:8px;flex-wrap:wrap}
.menu a{color:white;padding:8px;text-decoration:none;font-size:14px}
.hero{background:linear-gradient(135deg,#1565c0,#4527a0);color:white;text-align:center;padding:65px 20px}
.hero h1{font-size:44px;margin:0 0 12px}.hero p{font-size:18px;line-height:1.6;max-width:700px;margin:0 auto 22px}
.btn{display:inline-block;border:0;border-radius:25px;padding:12px 20px;background:#1565c0;color:white;text-decoration:none;font-weight:bold;cursor:pointer}
.hero .btn{background:white;color:#1565c0}
.container{max-width:1100px;margin:auto;padding:38px 18px}.title{text-align:center;font-size:30px;margin-bottom:25px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card,.job,.tool,.exam,form{background:white;border:1px solid #e1e6ef;border-radius:16px;padding:22px;box-shadow:0 3px 14px rgba(0,0,0,.06)}
.card{text-align:center}.icon{font-size:40px}.card p,.job p{color:#596475;line-height:1.5}
.jobs,.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.job h3{color:#1565c0}
.examgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.exam{border-left:5px solid #4527a0}
form{max-width:850px;margin:auto}label{display:block;font-weight:bold;margin:12px 0}
input,textarea{width:100%;padding:12px;margin-top:6px;border:1px solid #ccd3df;border-radius:8px;font-size:16px}
.paper{display:none;background:white;max-width:850px;margin:25px auto;padding:35px;border:1px solid #ddd}
.paper h1{color:#1565c0}.paper h2{border-bottom:2px solid #1565c0;padding-bottom:5px}
.quiz{max-width:800px;margin:auto;background:white;padding:25px;border-radius:16px}.q{margin:20px 0}.q label{font-weight:normal}
.result{display:none;background:#eef7ee;padding:15px;border-radius:10px;margin-top:18px}
.updates{background:#172033;color:white;border-radius:16px;padding:25px}
footer{background:#172033;color:white;text-align:center;padding:30px}
@media(max-width:750px){.grid,.jobs,.tools,.examgrid{grid-template-columns:1fr}.menu{display:none}.hero h1{font-size:34px}}
@media print{body *{visibility:hidden}.paper,.paper *{visibility:visible}.paper{position:absolute;left:0;top:0;width:100%;box-shadow:none;border:0}}
</style>
</head>
<body>
<header><div class="nav"><div class="logo">Guna Career Hub</div><nav class="menu">
